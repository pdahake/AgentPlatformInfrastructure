# Copy to .env and fill in real values before `docker compose up`.
# In this environment the real values live in Vault at secret/ai
# (ANTHROPIC_API_KEY, OPENAI_API_KEY) — see DECISIONS.md for how a real
# deployment would inject these instead of a plaintext .env file.

ANTHROPIC_API_KEY=changeme
OPENAI_API_KEY=changeme

# Local-only bearer key the agent/ingest use to call the litellm gateway.
# Not a real provider key — just an internal shared secret between our own
# containers, so provider keys never leave the litellm container.
LITELLM_MASTER_KEY=sk-local-master-changeme

POSTGRES_DB=agent_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Password for the agent's read-only DB role (agent_ro) — kept separate from
# POSTGRES_PASSWORD above (that's the superuser ingest connects as). Unlike
# POSTGRES_PASSWORD, which Postgres only applies on a genuinely fresh volume,
# this one is re-synced on every ingest run (see sql/schema.sql), so changing
# it and re-running ingest actually takes effect without a volume wipe.
POSTGRES_AGENT_RO_PASSWORD=changeme

# Which litellm model alias (see litellm/config.yaml) the agent uses by default.
AGENT_MODEL=claude-agent

# How many news headlines to embed via OpenAI for semantic search (rest stay
# full-text-searchable only — embedding all ~1.24M is a real batch job, not a
# `docker compose up` default). To embed the full corpus, run ingestion once
# standalone before `docker compose up`:
#   NEWS_EMBED_LIMIT=1244184 DATA_SOURCE=raw docker compose run --rm ingest
NEWS_EMBED_LIMIT=20000

# How many headline rows (of ~1.24M) to load into Postgres at all. 0 = unlimited.
# Independent of NEWS_EMBED_LIMIT above; only useful for fast local dev iteration.
NEWS_ROWS_LIMIT=0

# auto   = use data/export/<table>.copy.gz if present (fast), else fall back to raw.
#          This is the default so raw CSV parsing + embedding only ever happens
#          once per table — every run after that takes the fast export path.
# raw    = always (re-)parse data/raw/*.csv, ignoring any existing export.
# export = always restore from data/export/, error out if it's missing.
DATA_SOURCE=auto

# A raw ingestion run never overwrites an existing data/export/<table>.copy.gz
# (e.g. a full 1.24M-embedded export) with a smaller/different one (e.g. a quick
# NEWS_ROWS_LIMIT=1000 dev run) unless this is explicitly set to true.
EXPORT_OVERWRITE=false
