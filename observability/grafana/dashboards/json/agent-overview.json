{
  "title": "Agent Platform Overview",
  "uid": "agent-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Task runs / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(agent_tasks_total[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 2,
      "title": "Task duration (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(agent_task_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(agent_task_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3,
      "title": "LLM calls by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(agent_llm_calls_total[5m])) by (model, status)", "legendFormat": "{{model}}/{{status}}" }
      ]
    },
    {
      "id": 4,
      "title": "Tool calls by tool/status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(agent_tool_calls_total[5m])) by (tool, status)", "legendFormat": "{{tool}}/{{status}}" }
      ]
    },
    {
      "id": 5,
      "title": "Token usage rate (prompt vs completion)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(agent_llm_tokens_total[5m])) by (model, type)", "legendFormat": "{{model}}/{{type}}" }
      ]
    },
    {
      "id": 6,
      "title": "Tokens per task (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(agent_task_tokens_total_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(agent_task_tokens_total_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 7,
      "title": "Total tokens used (prompt + completion)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "targets": [
        { "expr": "sum(increase(agent_llm_tokens_total[$__range]))" }
      ]
    },
    {
      "id": 8,
      "title": "Total cost (USD)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } },
      "targets": [
        { "expr": "sum(increase(agent_llm_cost_usd_total[$__range]))" }
      ]
    },
    {
      "id": 9,
      "title": "Cost by model ($/5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        { "expr": "sum(rate(agent_llm_cost_usd_total[5m])) by (model)", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 10,
      "title": "Task failure rate (min. 30m window)",
      "description": "Pinned to a 30-minute window (timeFrom) regardless of the dashboard's selected time range — a shorter window on a low-traffic system only contains a handful of tasks, and one failure among 2-3 tasks swings this to 33%/50%/etc without reflecting any real underlying rate. This deliberately trades responsiveness to the time picker for a large-enough sample to be meaningful; contrast with 'Task failures (selected range)' below, which is a raw count and has no such problem.",
      "type": "stat",
      "timeFrom": "30m",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "100 * sum(increase(agent_tasks_total{status=\"failed\"}[$__range])) / sum(increase(agent_tasks_total[$__range]))" }
      ]
    },
    {
      "id": 11,
      "title": "Task failures (selected range)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 32 },
      "targets": [
        { "expr": "sum(increase(agent_tasks_total{status=\"failed\"}[$__range]))" }
      ]
    },
    {
      "id": 12,
      "title": "Errors by type (task/LLM/tool)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "sum(rate(agent_tasks_total{status=\"failed\"}[5m]))", "legendFormat": "task failures" },
        { "expr": "sum(rate(agent_llm_calls_total{status=\"error\"}[5m]))", "legendFormat": "llm errors" },
        { "expr": "sum(rate(agent_tool_calls_total{status=\"tool_error\"}[5m]))", "legendFormat": "tool errors" }
      ]
    },
    {
      "id": 13,
      "title": "Tool error rate by tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        { "expr": "sum(rate(agent_tool_calls_total{status=\"tool_error\"}[5m])) by (tool)", "legendFormat": "{{tool}}" }
      ]
    },
    {
      "id": 14,
      "title": "LLM call error rate by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "expr": "sum(rate(agent_llm_calls_total{status=\"error\"}[5m])) by (model)", "legendFormat": "{{model}}" }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}
